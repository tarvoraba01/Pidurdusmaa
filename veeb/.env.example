# Pidurdusmaa.ee — keskkonnamuutujate NIMED. Väärtused lähevad AINULT
# Coolifysse (rakendus → Environment Variables), mitte siia ega GitHubi.
# Kõik on valikulised: ilma nendeta töötab sait, vastav osa on lihtsalt väljas.

ORIGIN=https://pidurdusmaa.ee

# Kontaktivorm (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=
TURNSTILE_SECRET=

# Statistika ja haldus (vähemalt 16 juhuslikku märki; nt `openssl rand -hex 24`)
STATS_KEY=
ADMIN_KEY=

# Rehvipakkujad — üks paar iga pakkuja kohta (vt src/lib/server/integratsioonid/README.md)
# PAKKUJA_REHVIPOOD_URL=https://api.naide.ee/v1
# PAKKUJA_REHVIPOOD_VOTI=
