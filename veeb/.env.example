# Pidurdusmaa.ee — keskkonnamuutujate NIMED. Väärtused lähevad AINULT
# Coolifysse (rakendus → Environment Variables), mitte siia ega GitHubi.
# Kõik on valikulised: ilma nendeta töötab sait, vastav osa on lihtsalt väljas.

ORIGIN=https://pidurdusmaa.ee

# Kontaktivorm (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=
TURNSTILE_SECRET=

# Statistika ja haldus (vähemalt 16 juhuslikku märki; nt `openssl rand -hex 24`)
STATS_KEY=
ADMIN_KEY=

# Rehvipakkujad (vt src/lib/server/integratsioonid/README.md)
# Tammo / rehvivahetus.ee partner API. Võti annab ka TELLIMISE õiguse —
# hoia ainult Coolifys ja paroolihalduris, ära kunagi logi täis URL-i.
PAKKUJA_TAMMO_URL=https://partner.rehvivahetus.ee/api
PAKKUJA_TAMMO_VOTI=

# PocketBase (puhverandmebaas pakkumistele ja tootepiltidele) — lisandub Tammo ühendamisel
# Sisemine aadress Coolify võrgus, nt http://pocketbase:8090
PB_URL=
PB_ADMIN_EMAIL=
PB_ADMIN_PASS=
